# Copy this file to backend/.env and fill in your key.
# backend/.env is gitignored -- never commit real credentials.

# Massive market-data API key, from https://massive.com/dashboard/keys
# Leave blank to run on Yahoo Finance / demo data.
MASSIVE_API_KEY=

# Override only if Massive gives you a different endpoint. The API version
# lives inside each path, so this is the bare host.
# MASSIVE_BASE_URL=https://api.massive.com

# auto | massive | yahoo | demo
# "auto" uses Massive when a key is present, then falls back to Yahoo, then demo.
DATA_PROVIDER=auto
