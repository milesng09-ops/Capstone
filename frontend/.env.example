# Copy to .env.local and adjust as needed.

# Where the FastAPI backend is reachable.
VITE_API_BASE_URL=http://localhost:8000

# Try to load TradingView Advanced Charts from public/charting_library/.
# When the library files are absent, the app automatically falls back to
# Lightweight Charts -- no configuration change is needed.
VITE_USE_ADVANCED_CHARTS=true
