# Copy this file to backend/.env and fill in your key.
# backend/.env is gitignored -- never commit real credentials.

# Massive market-data API key, from https://massive.com/dashboard/keys
# Leave blank to run on Yahoo Finance.
MASSIVE_API_KEY=

# Override only if Massive gives you a different endpoint. The API version
# lives inside each path, so this is the bare host.
# MASSIVE_BASE_URL=https://api.massive.com

# auto | massive | yahoo | demo
# "auto" uses Massive when a key is present, then falls back to Yahoo.
#
# Demo data is NOT part of any automatic chain: a quota or an outage must
# never quietly substitute generated candles for real prices, because a
# backtest scored on them looks exactly like one scored on the market. Set
# this to "demo" to ask for it deliberately.
DATA_PROVIDER=auto

# Massive's published quota. Enforced on our side too, because exceeding it
# costs a two-minute cool-off rather than just the one rejected call.
# MASSIVE_MAX_REQUESTS_PER_MINUTE=5

# How long a request waits for a free slot before falling through to Yahoo.
# The default is one full window, so a request queues for Massive rather than
# switching source -- at the cost of waiting up to a minute for the bars.
# Lower it to prefer a fast answer from Yahoo over a slow one from Massive.
# MASSIVE_THROTTLE_MAX_WAIT_SECONDS=60
